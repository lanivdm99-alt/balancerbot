# ═══════════════════════════════════════════════════════════
# FLASH-X Configuration - $4 Starting Capital on Polygon
# ═══════════════════════════════════════════════════════════

# ─── RPC Provider ──────────────────────────────────────────
POL_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/alch_2vyGIJRc9zdXptWHGeTM1
POL_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/alch_2vyGIJRc9zdXptWHGeTM1

# ─── Wallet ────────────────────────────────────────────────
# ⚠️ $4 STARTING CAPITAL - Be very careful!
# This is enough for ~400-800 transactions on Polygon
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# ─── Contract Address ──────────────────────────────────────
POL_FLASH_ARB=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# ─── Bot Configuration (Optimized for $4) ─────────────────
# Minimum profit: $0.01 (1 cent) - very low threshold
MIN_PROFIT_USD=0.01

# Maximum gas: 50 Gwei (Polygon is cheap, but don't overspend)
MAX_GAS_GWEI=50

# Scan interval: 3 seconds (faster = more opportunities)
SCAN_INTERVAL_MS=3000

# Dry run mode: START WITH THIS TRUE!
DRY_RUN=true

# Flash loan provider: Uniswap V3 Flash (FREE)
FLASH_LOAN_PROVIDER=uniswap_v3_flash

# MEV tip: 90% (competitive environment)
MEV_TIP_PERCENTAGE=90

# Maximum slippage: 30 bps (0.3%)
MAX_SLIPPAGE_BPS=30

# ─── Capital Management ────────────────────────────────────
# With $4, you can afford:
# - ~400-800 transactions (gas ~$0.005-0.01 each)
# - Flash loans up to pool liquidity (FREE borrowing)
# - But profits must exceed gas + MEV tips

# Strategy: Start with smallest profitable trades
# Target: $0.01-0.05 profit per trade
# Goal: Grow $4 → $10 → $50 → $100

# ─── Alerting ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/flash-x.log
