# ═══════════════════════════════════════════════════════════
# FLASH-X Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ─── RPC Providers ─────────────────────────────────────────
# Use PRIVATE endpoints (Alchemy/Infura) for lowest latency
# Public RPCs are rate-limited and too slow for MEV

# Polygon PoS (CONFIGURED ✓)
POL_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/alch_2vyGIJRc9zdXptWHGeTM1
POL_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/alch_2vyGIJRc9zdXptWHGeTM1

# Arbitrum One (NEEDS CONFIGURATION)
# Get from: https://www.alchemy.com/ or https://infura.io/
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARB_WSS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ─── Flashbots ─────────────────────────────────────────────
# Required for private transaction submission (MEV-Share)
# Register at: https://flashbots.net
# Get your auth signer key from the Flashbots dashboard

FLASHBOTS_AUTH_SIGNER=0xYOUR_FLASHBOTS_SIGNER_KEY
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# ─── Wallet ────────────────────────────────────────────────
# ⚠️ USE A DEDICATED HOT WALLET - NEVER your main wallet
# Fund with small amounts for gas only (0.1-0.5 ETH recommended)
# Generate with: cast wallet new

PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# ─── Contract Addresses ────────────────────────────────────
# Fill these in after deploying FlashArbX.sol
# Deploy command: forge script script/Deploy.s.sol --rpc-url $RPC_URL --broadcast

ARB_FLASH_ARB=0xDEPLOYED_ARBITRUM_CONTRACT_ADDRESS
POL_FLASH_ARB=0xDEPLOYED_POLYGON_CONTRACT_ADDRESS

# Balancer V3 Vault (same on all chains - DO NOT CHANGE)
BALANCER_V3=0xBA12222222228d8Ba445958a75a0704d566BF2C8

# ─── Bot Configuration ────────────────────────────────────
# Minimum net profit in USD to execute a trade
# Start conservative: $5-10 for testing
MIN_PROFIT_USD=5.00

# Maximum gas price in Gwei (skip if gas is too high)
# Arbitrum: 100-200 Gwei is fine
# Polygon: 100-300 Gwei is fine
MAX_GAS_GWEI=100

# Scan interval in milliseconds (500ms = 2 scans/second)
# Lower = more opportunities but higher RPC costs
SCAN_INTERVAL_MS=500

# Dry run mode (true = simulation, false = live execution)
# ⚠️ ALWAYS start with DRY_RUN=true
DRY_RUN=true

# Enable Flashbots for private transactions
# Reduces front-running risk significantly
USE_FLASHBOTS=true

# MEV tip percentage (75-90 recommended for competitive env)
# Higher = more likely to be included, but less profit
MEV_TIP_PERCENTAGE=80

# Maximum slippage per swap leg (in basis points)
# 50 bps = 0.5% slippage tolerance
MAX_SLIPPAGE_BPS=50

# ─── Alerting (Optional) ──────────────────────────────────
# Telegram notifications for trades and errors
# Create bot: https://t.me/BotFather
# Get chat ID: Send message to your bot, then visit:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/flash-x.log
